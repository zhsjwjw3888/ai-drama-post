# Public release allowlist: legacy local production artifacts stay untracked.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/CONTRIBUTING.md
!/SECURITY.md
!/ai-drama-post/
!/docs/
/docs/*
!/docs/images/
/docs/images/*
!/docs/images/workflow.png
!/docs/images/cli-demo.png
/ai-drama-post/**/__pycache__/
/ai-drama-post/**/*.pyc
/ai-drama-post/**/*.log
/ai-drama-post/.env*
/ai-drama-post/**/.env*
